# Database URL: Local PostgreSQL installed on your machine
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: If PostgreSQL is not active, JalDoot automatically uses local SQLite (jaldoot.db) with 0 crash.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jaldoot

# JWT Security
SECRET_KEY=jaldoot_secret_marine_safety_key_2026_super_secure

# Hardcoded Admin credentials (enforced strictly on backend)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin1234

# Google Gemini Free Tier API Key (Optional: system provides domain expert fallback when blank)
GEMINI_API_KEY=

# Free Carrier Email-to-SMS Gateway Settings (Optional: logs to console + DB by default)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_ALERT_PHONE=+919876543210
ADMIN_CARRIER_GATEWAY=vtext.com
